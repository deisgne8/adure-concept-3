# Server-only WordPress API configuration.
WORDPRESS_URL=https://adure.e8demo.com
WORDPRESS_HOME_PAGES_ENDPOINT=/wp-json/wp/v2/pages
WORDPRESS_PROPERTIES_ENDPOINT=/wp-json/adure/v1/properties
WORDPRESS_BUILDINGS_ENDPOINT=/wp-json/adure/v1/buildings
WORDPRESS_UNITS_ENDPOINT=/wp-json/adure/v1/units
WORDPRESS_PROPERTY_IMPORT_ENDPOINT=/wp-json/adure/v1/property-import
